# === Database ===
# Postgres container credentials (used by docker-compose db service)
# ⚠️  If you change POSTGRES_USER, POSTGRES_PASSWORD, or POSTGRES_DB here,
#     you MUST also update DATABASE_URL below to match — otherwise Prisma will
#     try to connect with the old credentials and fail.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pearl_local

# Connection string for Prisma — uncomment the line that matches your setup:
# Local dev (non-Docker):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pearl_local?schema=public"
# Docker / docker-compose (uses the "db" service name instead of localhost):
DATABASE_URL="postgresql://postgres:postgres@db:5432/pearl_local?schema=public"

# === API ===
# Port for the API server (must match EXPOSE in Dockerfile — 3000)
PORT=3000
# Environment: 'development', 'production', or 'test'
# Set to 'production' on the server; keep 'development' for local work
NODE_ENV="development"
# Allowed origin for CORS
CORS_ORIGIN="http://localhost:5173"

# === Auth ===
# Secret key for signing JWTs - must be at least 32 characters, use a strong random value in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-secret-of-at-least-32-chars"
# JWT expiry duration (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN="7d"

# === AI ===
# Google Gemini API key for resume parsing (optional - resume parse endpoint returns 503 without it)
GEMINI_API_KEY="your-gemini-api-key-here"

# === Web Client ===
# Base URL for API requests from the frontend
VITE_API_URL="http://localhost:3001"