# === Database ===
# Connection string for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pearl_local?schema=public"

# === API ===
# Port for the API server
PORT=3001
# Environment: 'development', 'production', or 'test'
NODE_ENV="development"
# Allowed origin for CORS
CORS_ORIGIN="http://localhost:5173"

# === Auth ===
# Secret key for signing JWTs - must be at least 32 characters, use a strong random value in production
JWT_SECRET="change-this-to-a-strong-random-secret-of-at-least-32-chars"
# JWT expiry duration (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN="7d"

# === Web Client ===
# Base URL for API requests from the frontend
VITE_API_URL="http://localhost:3001"