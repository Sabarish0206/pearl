// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  student     Student?
  faculty     Faculty?
  createdJobs JobRequirement[] @relation("CreatedJobs")

  @@map("users")
}

model Student {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  firstName        String   @map("first_name")
  lastName         String   @map("last_name")
  registerNumber   String   @map("register_number")
  department       String
  batchYear        Int      @map("batch_year")
  cgpa             Decimal? @map("cgpa") @db.Decimal(4, 2)
  activeArrears    Int?     @map("active_arrears")
  historyOfArrears Int?     @map("history_of_arrears")
  tenthMark        Decimal? @map("tenth_mark") @db.Decimal(5, 2)
  twelfthMark      Decimal? @map("twelfth_mark") @db.Decimal(5, 2)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume        Resume?
  studentSkills StudentSkill[]

  @@map("students")
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  studentSkills StudentSkill[]

  @@map("skills")
}

model StudentSkill {
  studentId String @map("student_id")
  skillId   String @map("skill_id")
  source    String @default("RESUME")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentId, skillId])
  @@map("student_skills")
}

model Resume {
  id         String   @id @default(uuid())
  studentId  String   @unique @map("student_id")
  filePath   String   @map("file_path")
  atsScore   Int?     @map("ats_score")
  parsedData Json?    @map("parsed_data")
  isVerified Boolean  @default(false) @map("is_verified")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model Faculty {
  id          String @id @default(uuid())
  userId      String @unique @map("user_id")
  fullName    String @map("full_name")
  designation String
  department  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("faculty")
}

model JobRequirement {
  id              String    @id @default(uuid())
  title           String
  companyName     String    @map("company_name")
  description     String
  requiredSkills  String[]  @map("required_skills")
  minCgpa         Decimal?  @map("min_cgpa") @db.Decimal(4, 2)
  maxArrears      Int?      @map("max_arrears")
  eligibleDepts   String[]  @map("eligible_depts")
  minExperienceYr Int       @default(0) @map("min_experience_yr")
  salaryLpa       Decimal?  @map("salary_lpa") @db.Decimal(8, 2)
  deadline        DateTime?
  isActive        Boolean   @default(true) @map("is_active")
  createdBy       String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  creator User @relation("CreatedJobs", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("job_requirements")
}
